# =====================================================================
# PSXpert Database Configuration
# =====================================================================

# Option A: Full Connection URL
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/psxpert
# SQLite (Local Embedded):
DATABASE_URL=sqlite:///data/psxpert.db

# Option B: Individual PostgreSQL Parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=psxpert
