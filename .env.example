# =====================================================================
# PSXpert Database & Pipeline Configuration
# =====================================================================

# Option A: Full Connection URL
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/psxpert
# SQLite (Local Embedded Fallback):
DATABASE_URL=sqlite:///data/psxpert.db

# Option B: Individual PostgreSQL Parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=psxpert

# Optional External Raw Dataset Directory (used by src/database/enrich_ohlc.py & merge_external_repo.py)
# PSX_EXTERNAL_DATA_DIR=
