  "target_definition": {
    "target_name": "next_12m_fundamental_health_and_distress_outcome",
    "classes": [
      "Strong",
      "Moderate",
      "Weak"
    ],
    "economic_definition": {
      "Strong": "Company maintains or achieves investment-grade credit stability (PACRA/VIS >= A-), delivers positive YoY operating income/EPS growth, ROE >= sector median (or >= 15%), positive Free Cash Flow (OCF/NI >= 0.8), and maintains uninterrupted cash dividends.",
      "Moderate": "Company stays solvent with positive operating cash flow and no rating downgrade or covenant breach, but shows flat/modest earnings growth, margin compression, or moderate leverage.",
      "Weak": "Independent external credit rating downgrade to sub-investment tier (< BBB) / PSX Defaulter Counter placement / dividend omission after prior payouts, OR severe realized FY_{t+1} distress (net loss <= 0, negative operating cash flow, equity erosion, or Interest Coverage < 1.25x)."
    },
    "mandatory_data_prerequisites": [
      "1. Historical PACRA / VIS credit-rating panel and PSX Defaulter Segment / delisting date logs (eliminating 100% survivorship bias).",
      "2. >= 8-10 years of audited annual + clean quarterly IFRS disclosures across >= 300+ firms (>= 1,500 non-overlapping train transitions before Val/Test).",
      "3. Full sector classification for the 61 currently unclassified IFRS firms (of 711 unclassified total) and pre-2025 corporate_payouts dividend backfill."
    ]
  },
